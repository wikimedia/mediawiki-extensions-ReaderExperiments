		"Marco Fossati",
		"Eric Gardner",
		"Roan Kattouw",
		"Matthias Mullie",
		"Jon Robson",
		"Kimberly Sarabia",
		"Brooke Vibber",
		"Lauralyn Watson"
	],
	"url": "https://www.mediawiki.org/wiki/Special:MyLanguage/Extension:ReaderExperiments",
	"descriptionmsg": "readerexperiments-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.47.0"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\ReaderExperiments\\": "src/"
	},
	"config": {
		"ReaderExperimentsApiBaseUri": {
			"description": "Url to API of MediaWiki instance to use for external data (e.g. when using MobileFrontendContentProvider, in which case this should be equal to $wgMFMwApiContentProviderBaseUri), or leave empty to use local API.",
			"value": ""
		},
		"ReaderExperimentsImageBrowsingExternalWikis": {
			"description": "Map of external wiki domains from which to show other images, to the message key to use when describing the project name.",
			"value": {
				"wikipedia.org": "/* i18n-unused */",
				"wikidata.org": "wikibase-otherprojects-wikidata"
			}
		},
		"ReaderExperimentsPreferredSourcesDebug": {
			"description": "Local development only: bypass the Google-referrer gate and the CTA suppression flag for the preferred-sources experiment.",
			"value": false
		},
		"ReaderExperimentsSemanticSearchAllowOptIn": {
			"description": "Whether or not to provide the option for users to opt in to Special:SemanticSearch",
			"value": false
		}
	},
	"HookHandlers": {
		"ImageCarouselRetestHooks": {
			"class": "MediaWiki\\Extension\\ReaderExperiments\\Experiments\\ImageCarouselRetest\\Hooks",
			"optional_services": [ "TestKitchen.ExperimentManager" ]
		},
		"ImageBrowsingHooks": {
			"class": "MediaWiki\\Extension\\ReaderExperiments\\Experiments\\ImageBrowsing\\Hooks",
			"optional_services": [
				"TestKitchen.ExperimentManager"
			]
		},
		"MinervaTocHooks": {
			"class": "MediaWiki\\Extension\\ReaderExperiments\\Experiments\\MinervaToc\\Hooks",
			"optional_services": [
				"TestKitchen.ExperimentManager"
			]
		},
		"MinervaTocParserMigrationHooks": {
			"class": "MediaWiki\\Extension\\ReaderExperiments\\Experiments\\MinervaToc\\ParserMigrationHooks",
			"optional_services": [
				"TestKitchen.ExperimentManager"
			]
		},
		"MinimalMinervaToolbarMinervaHooks": {
			"class": "MediaWiki\\Extension\\ReaderExperiments\\Experiments\\MinimalMinervaToolbar\\MinervaHooks",
			"optional_services": [
				"TestKitchen.ExperimentManager"
			]
		},
		"MobilePagePreviewsHooks": {
			"class": "MediaWiki\\Extension\\ReaderExperiments\\Experiments\\MobilePagePreviews\\Hooks",
			"optional_services": [
				"TestKitchen.ExperimentManager"
			]
		},
		"PreferredSourcesHooks": {
			"class": "MediaWiki\\Extension\\ReaderExperiments\\Experiments\\PreferredSources\\Hooks"
		},
		"ShareHighlightHooks": {
			"class": "MediaWiki\\Extension\\ReaderExperiments\\Experiments\\ShareHighlight\\Hooks",
			"optional_services": [
				"TestKitchen.ExperimentManager"
			]
		},
		"SemanticSearchHooks": {
			"class": "MediaWiki\\Extension\\ReaderExperiments\\Experiments\\SemanticSearch\\Hooks",
			"optional_services": [
				"MainConfig"
			]
		},
		"StickyHeadersHooks": {
			"class": "MediaWiki\\Extension\\ReaderExperiments\\Experiments\\StickyHeaders\\Hooks",
			"optional_services": [
				"TestKitchen.ExperimentManager"
			]
		},
		"MinervaCompactLeadHooks": {
			"class": "MediaWiki\\Extension\\ReaderExperiments\\Experiments\\MinervaCompactLead\\Hooks",
			"optional_services": [
				"TestKitchen.ExperimentManager",
				"MobileFrontend.Context"
			]
		}
	},
	"Hooks": {
		"MultimediaViewerBeforeMobileCarousel": "ImageCarouselRetestHooks",
		"BeforePageDisplay": [
			"ImageBrowsingHooks",
			"MinervaTocHooks",
			"MobilePagePreviewsHooks",
			"PreferredSourcesHooks",
			"ShareHighlightHooks",
			"StickyHeadersHooks",
			"MinervaCompactLeadHooks"
		],
		"BeforeInitialize": [
			"MinervaTocHooks"
		],
		"GetPreferences": [
			"SemanticSearchHooks"
		],
		"ShouldUseParsoid": [
			"MinervaTocParserMigrationHooks"
		],
		"SkinTemplateNavigation::Universal": [
			"ShareHighlightHooks"
		],
		"SkinMinervaOptionsInit": [
			"MinimalMinervaToolbarMinervaHooks"
		]
	},
	"MessagesDirs": {
		"ReaderExperiments": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"ReaderExperimentsAlias": "ReaderExperiments.i18n.alias.php"
	},
