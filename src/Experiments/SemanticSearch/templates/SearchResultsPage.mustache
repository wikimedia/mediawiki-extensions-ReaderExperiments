{{!
	SERPWidget template. This file sets up the no-JS fallback UI for
	Special:SemanticSearch using simple HTML form tags.
}}
<form method="get" action="{{request.page}}" class="ext-readerExperiments-semanticsearch-form">
	{{#request.queryParams}}
		{{!
			New searches will have a new search term,
			and should always start from first result
		}}
		{{^isSearch}}
			{{^isContinue}}
				<input type="hidden" name="{{key}}" value="{{value}}" />
			{{/isContinue}}
		{{/isSearch}}
	{{/request.queryParams}}
	<input type="hidden" name="noredirect" value="" />

	<div class="cdx-search-input cdx-search-input--has-end-button">
		<div class="cdx-search-input__input-wrapper">
			<div class="cdx-text-input cdx-text-input--has-start-icon cdx-text-input--status-{{#response.lexical.error}}error{{/response.lexical.error}}{{^response.lexical.error}}default{{/response.lexical.error}} cdx-search-input__text-input">
				<input
					class="cdx-text-input__input {{#request.hasTerm}}cdx-text-input__input--has-value{{/request.hasTerm}}"
					type="search"
					placeholder="{{output.searchPlaceholderText}}"
					value="{{request.term}}"
					name="search"
					dir="auto"
				>
				<span class="cdx-text-input__icon cdx-text-input__start-icon"></span>
			</div>
		</div>
		<button class="cdx-button cdx-button--action-default cdx-button--weight-normal cdx-button--size-medium cdx-button--framed cdx-search-input__end-button">{{output.searchButtonText}}</button>
	</div>
</form>

{{#response.lexical}}
	{{>SearchInfo}}
{{/response.lexical}}

{{#request.semanticEnabled}}
	{{#response.semantic}}
		<section class="ext-readerExperiments-semanticsearch-results ext-readerExperiments-semanticsearch-results--semantic" aria-label="{{output.semanticResultsLabel}}">
			{{#results}}
				{{>SearchResult}}
			{{/results}}
		</section>
	{{/response.semantic}}
{{/request.semanticEnabled}}

{{#response.lexical}}
	<section class="ext-readerExperiments-semanticsearch-results ext-readerExperiments-semanticsearch-results--lexical" aria-label="{{output.lexicalResultsLabel}}">
		{{#results}}
			{{>SearchResult}}
		{{/results}}
	</section>
{{/response.lexical}}

{{#output.pagination}}
	<div class="ext-readerExperiments-semanticsearch-actions">
		{{#prev}}
			<a href="{{.}}" class="cdx-button cdx-button--fake-button cdx-button--fake-button--enabled cdx-button--action-progressive cdx-button--weight-primary">{{output.previousText}}</a>
		{{/prev}}
		{{#next}}
			<a href="{{.}}" class="cdx-button cdx-button--fake-button cdx-button--fake-button--enabled cdx-button--action-progressive cdx-button--weight-primary">{{output.continueText}}</a>
		{{/next}}
	</div>
{{/output.pagination}}

<a href="{{output.classicSearchUrl}}" id="readerexperiments-semanticsearch-switch-special-search" class="ext-readerExperiments-semanticsearch-classic">{{output.switchToClassicSearchText}}</a>
