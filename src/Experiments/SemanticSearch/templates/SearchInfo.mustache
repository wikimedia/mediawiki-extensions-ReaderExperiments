{{#output.didYouMeanText}}
	<p class="ext-readerExperiments-semanticsearch-suggestion" aria-live="polite">{{{.}}}</p>
{{/output.didYouMeanText}}

{{^results}}
	{{^error}}
		{{#request.hasTerm}}
			<p class="ext-readerExperiments-semanticsearch-no-results" aria-live="polite">{{output.noResultsText}}</p>
		{{/request.hasTerm}}
	{{/error}}
{{/results}}

{{#warnings}}
	<div
		class="cdx-message cdx-message--block cdx-message--warning"
		aria-live="polite"
	>
		<span class="cdx-message__icon"></span>
		<div class="cdx-message__content">{{.}}</div>
	</div>
{{/warnings}}

{{#error}}
	<div class="cdx-message cdx-message--block cdx-message--error" role="alert">
		<span class="cdx-message__icon"></span>
		<div class="cdx-message__content">
			<p><strong>{{output.errorTitleText}}</strong></p>
			<p>
				{{{.}}}
			</p>
			<p>
				{{output.errorText}}
			</p>
		</div>
	</div>
{{/error}}
