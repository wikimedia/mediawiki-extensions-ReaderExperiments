<a
	href="{{targeturl}}"
	title="{{title}}"
	data-namespace="{{ns}}"
	class="cdx-card cdx-card--is-link ext-readerExperiments-semanticsearch-result {{#semantic}}ext-readerExperiments-semanticsearch-result--semantic{{/semantic}}"
>
	{{#semantic}}
		<div class="ext-readerExperiments-semanticsearch-result__quote">
			<span class="ext-readerExperiments-semanticsearch-result__quote-mark" aria-hidden="true"></span>
			<span>{{{semanticExcerpt}}}</span>
		</div>
	{{/semantic}}
	<span class="cdx-thumbnail cdx-card__thumbnail">
		{{#thumbnail}}
		<span
			style="background-image: url( {{source}} );"
			class="cdx-thumbnail__image"
		></span>
		{{/thumbnail}}
		{{^thumbnail}}<span class="cdx-thumbnail__placeholder"><span class="cdx-thumbnail__placeholder__icon"></span></span>{{/thumbnail}}
	</span>
	<span class="cdx-card__text">
		<span class="cdx-card__text__title">
			{{title}}
			{{^semantic}}{{sectionText}}{{/semantic}}
			{{redirectText}}
		</span>
		{{#semantic}}
			{{#sectiontitle}}<div class="ext-readerExperiments-semanticsearch-result__section"><span class="ext-readerExperiments-semanticsearch-result__section-arrow" aria-hidden="true">↪</span> {{.}}</div>{{/sectiontitle}}
		{{/semantic}}
		{{^semantic}}
		{{#snippet}}
			<div class="cdx-card__text__description">
				{{{.}}}{{output.ellipsisText}}
			</div>
		{{/snippet}}
		{{/semantic}}
		<span class="cdx-card__text__supporting-text">
			{{#contributorsText}}<span>{{.}}</span>{{/contributorsText}}
			{{#referencesText}}<span>{{.}}</span>{{/referencesText}}
		</span>
	</span>
</a>
